# GMXReply — env template for Render / local
# Copy to .env and fill values. Never commit .env.

# Required on Render
NODE_ENV=production
ADMIN_PASSWORD=your-secure-admin-password
PORT=10000
TRUST_PROXY=1

# Database (default SQLite; Render disk at /var/data)
DB_PATH=/var/data/data.sqlite

# Supabase (optional — set DB_MODE=supabase to use)
# DB_MODE=supabase
# SUPABASE_URL=https://xxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Solana (billing)
# SOL_RECEIVER=your_wallet_address
# SOLANA_RPC=https://api.mainnet-beta.solana.com
# SOLANA_RPC_PUBLIC=https://api.mainnet-beta.solana.com

# CORS (set your domain for production)
# ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Extension (after Chrome Web Store publish)
# EXTENSION_IDS=chrome-extension-id
# EXTENSION_STORE_URL=https://chromewebstore.google.com/detail/xxx

# Limits (optional overrides)
# GMX_SAVE_CAP_FREE=50
# GMX_FREE_DAILY=70
